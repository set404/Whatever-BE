# Copy to .env (gitignored) and fill in.

# Neon connection string (Project > Connection Details). Include ?sslmode=require.
DATABASE_URL=

# Any long random string (e.g. `openssl rand -hex 32`). Signs/verifies access tokens.
JWT_SECRET=

# Used to build password-reset links emailed to users.
FRONTEND_URL=http://localhost:4200

# Brevo (https://brevo.com) — HTTP email API, works on any Render tier
# (Render blocks outbound SMTP ports on free-tier services). Get an API key
# at Brevo dashboard > SMTP & API > API Keys. BREVO_FROM_EMAIL must be a
# sender verified in Brevo (dashboard > Senders, Domains & Dedicated IPs).
# Leave unset locally to have password-reset links logged to the console
# instead of emailed.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# One-time bootstrap: `npm run seed:superadmin` promotes this account (must have
# already signed up through the app) to superadmin.
BOOTSTRAP_SUPERADMIN_EMAIL=
