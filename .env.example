# Copy to .env (gitignored) and fill in.

# Neon connection string (Project > Connection Details). Include ?sslmode=require.
DATABASE_URL=

# Any long random string (e.g. `openssl rand -hex 32`). Signs/verifies access tokens.
JWT_SECRET=

# Used to build password-reset links emailed to users.
FRONTEND_URL=http://localhost:4200

# Gmail SMTP — a Gmail account with 2FA on, and an App Password generated at
# https://myaccount.google.com/apppasswords. Leave unset locally to have
# password-reset links logged to the console instead of emailed.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudflare R2 (S3-compatible) — restaurant image uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=restaurant-images
# Bucket's public base URL (r2.dev subdomain or a custom domain), no trailing slash.
R2_PUBLIC_URL=

# One-time bootstrap: `npm run seed:superadmin` promotes this account (must have
# already signed up through the app) to superadmin.
BOOTSTRAP_SUPERADMIN_EMAIL=
