// Using the classic CJS-native generator, not the newer "prisma-client" one: the
// latter emits `import.meta.url` even in CommonJS output, which is a hard
// SyntaxError under Nest's default CJS build. This generator has no such issue.
// No custom `output`: it generates into node_modules/.prisma/client, resolved at
// runtime via the `@prisma/client` package (already a dependency) — that indirection
// is what lets `dist/` resolve it identically to `src/`, with nothing for our own
// build to copy or compile.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  globalRole   String   @default("member") @map("global_role")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Opaque refresh tokens are stored hashed; the raw value only ever lives in the
/// httpOnly cookie handed to the client. Rotated (deleted + reissued) on every use.
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Group {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members     GroupMember[]
  restaurants Restaurant[]
  decisions   Decision[]
  invitations Invitation[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Restaurant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  name       String
  imageUrl   String?  @map("image_url")
  websiteUrl String?  @map("website_url")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  active     Boolean  @default(true)

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@map("restaurants")
}

model Decision {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String   @map("group_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  decisionDate DateTime @map("decision_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([groupId, decisionDate])
  @@map("decisions")
}

/// Restaurant photos, stored directly in Postgres rather than object storage
/// (no external storage provider wired up) — served back via GET /uploads/images/:id.
model Image {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data        Bytes
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("images")
}

model Invitation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  code      String    @unique
  /// Set only for email invites (createInvitation's open/shareable codes leave this
  /// null) — lowercased, and joinByCode requires the joining user's email to match.
  email     String?
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("invitations")
}
